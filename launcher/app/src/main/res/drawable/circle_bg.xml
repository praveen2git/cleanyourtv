<?xml version="1.0" encoding="utf-8"?>
<!-- tvos_style top-bar button: a frosted glass circle that turns solid white on focus (pill_bg's colours). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#F5FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
        </shape>
    </item>
</selector>
